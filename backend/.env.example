PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/cardverse
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Comma-separate IDs when web and native tokens use different OAuth clients.
GOOGLE_CLIENT_IDS=replace_with_your_google_oauth_client_id.apps.googleusercontent.com
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=*
NODE_ENV=development
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
